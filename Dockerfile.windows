# Dockerfile for cross-compiling Neve 1073 to Windows
FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    mingw-w64 \
    pkg-config \
    libfreetype6-dev \
    libx11-dev \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libgl1-mesa-dev \
    libasound2-dev \
    curl \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Set up MinGW toolchain
ENV CC=x86_64-w64-mingw32-gcc
ENV CXX=x86_64-w64-mingw32-g++

# Create build directory
WORKDIR /build

# Copy source code
COPY . /src

# Create CMake toolchain file for MinGW
RUN echo 'set(CMAKE_SYSTEM_NAME Windows)\n\
set(CMAKE_SYSTEM_PROCESSOR x86_64)\n\
set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc)\n\
set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++)\n\
set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)\n\
set(CMAKE_SYSROOT /usr/x86_64-w64-mingw32)\n\
set(CMAKE_FIND_ROOT_PATH /usr/x86_64-w64-mingw32)\n\
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)\n\
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)\n\
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)\n\
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)\n\
# Add MinGW include paths explicitly\n\
include_directories(SYSTEM /usr/x86_64-w64-mingw32/include)\n\
include_directories(SYSTEM /usr/share/mingw-w64/include)\n\
# Disable JUCE extras that cause issues with cross-compilation\n\
set(JUCE_BUILD_EXTRAS OFF CACHE BOOL "" FORCE)\n\
set(JUCE_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)\n\
# Disable ALSA for Windows build\n\
set(JUCE_ASIO OFF)\n\
set(JUCE_JACK OFF)\n\
set(JUCE_ALSA OFF)\n\
' > /build/mingw-toolchain.cmake

# Build command
CMD ["sh", "-c", "cd /build && \
    cmake /src \
    -DCMAKE_TOOLCHAIN_FILE=/build/mingw-toolchain.cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_FLAGS='-static-libgcc -static-libstdc++' && \
    make -j$(nproc) && \
    mkdir -p /output && \
    cp -r Neve1073_artefacts/Release/VST3/* /output/ 2>/dev/null || true && \
    cp -r Neve1073_artefacts/Release/Standalone/* /output/ 2>/dev/null || true && \
    echo 'Build complete! Output in /output'"]
